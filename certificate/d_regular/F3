bool X_cond3(double a2, double a3, double a4) {
    // Linear sufficient condition ensuring trapping via B(0,5) with s=5,
    // protected by A(0,5), A(1,5):
    // a2 >= 2, a3 > 0, a4 > 0, and a4 <= a2 + 1.
    return (a2 >= 2.0) && (a4 <= a2 + 1.0);
}

double AX_upper_bound3(double a2, double a3, double a4) {
    // Upper bound for |A0 An| obtained from:
    // |OA4| + (a2 + 2*a3 + a4 - 1).
    // where |OA4| = sqrt((1 + a2/2 - a3/2 - a4)^2 + (3/4)*(a2 + a3)^2).
    const double x4 = 1.0 + 0.5*a2 - 0.5*a3 - a4;
    const double y4_sq = 0.75 * (a2 + a3) * (a2 + a3); // (3/4)*(a2 + a3)^2
    const double OA4 = std::sqrt(x4*x4 + y4_sq);
    return OA4 + (a2 + 2.0*a3 + a4 - 1.0);
}


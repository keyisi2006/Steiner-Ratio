ld operator()(ull mono_mask, ld b, ld c, ld d, ld s, ld t, ld u, ld e, ld f) {
if(!(__f2_detail::X_cond(s,u,e)) || (mono_mask | 0) != 0) return INF;
ld A_X = __f2_detail::AX_upper_bound(s, u, e);
ld L_s_minus = b + s + 1;
ld L_t = A_X;
ld L_s_plus = sqrt(b*b + b*s + s*s);
return rho*L_t + L_s_plus - L_s_minus;
}};


namespace __f6_detail {
bool steiner_cond(double b, double c, double d, double s, double e) {
    // Nonnegativity
    if (b < 0 || c < 0 || d < 0 || s < 0 || e < 0) return false;
    // Simple linear constraints ensuring the U-angle constraints and helping the V-angles
    if (d < b) return false;
    if (d < e) return false;

    // Relaxed intersection-angle constraint: dot(Q - B, R - D) >= 0
    // Derived closed form:
    // dot3 = (2*c^2 + b*(2*c + d + e) - (d + e)*(d + s) + c*(2*d + e + s)) / 2
    double dot3 = (2.0*c*c + b*(2.0*c + d + e) - (d + e)*(d + s) + c*(2.0*d + e + s)) / 2.0;
    if (dot3 < 0) return false;

    return true;
}

double steiner_length(double b, double c, double d, double s, double e) {
    // |UV|^2 = (3/4)(s + c + 2d + e)^2 + (b + s/2 + c/2 + d + e/2)^2
    // Equivalently, |UV| = (1/2) * sqrt( (2b + c + 2d + e + s)^2 + 3*(c + 2d + e + s)^2 )
    double t1 = (2.0*b + c + 2.0*d + e + s);
    double t2 = (c + 2.0*d + e + s);
    double val = 0.5 * std::sqrt(t1*t1 + 3.0*t2*t2);
    return val;
}

}


#include <cmath>
#include <algorithm>

bool steiner_cond(double b, double c, double d, double s, double e) {
    // Nonnegativity
    if (b < 0 || c < 0 || d < 0 || s < 0 || e < 0) return false;

    // Convexity nontrivial edge: d(c + e - 1) + e(s + c) ≥ 0
    if (d * (c + e - 1.0) + e * (s + c) < 0.0) return false;

    // Angle at R threshold: e ≥ f(c + s, d) with f(t, d) = ( -(t + 2d) + sqrt( (t + 2d)^2 + 4d ) ) / 2
    const double t = c + s;
    const double w = t + 2.0 * d;
    const double rad = w * w + 4.0 * d;
    const double thr = ( -w + std::sqrt(rad) ) / 2.0;
    if (e + 1e-12 < thr) return false;

    // Third relaxed constraint: dot(AQ, DR) ≥ 0
    // AQ = Q - A, DR = R - D. Using the simplified expression:
    // dot = -(1 + s/2 - c/2 + d/2)·(c/2 + e + d) + (3/4)·c·(s + c + d)
    const double alpha = 1.0 + 0.5 * s - 0.5 * c + 0.5 * d;
    const double dot_third = -alpha * (0.5 * c + e + d) + 0.75 * c * (s + c + d);
    if (dot_third < -1e-12) return false;

    // Axis-parallel monotonicity helpers for dot(AQ,DR):
    // s + e ≥ 1 and c ≤ 1 + d + (s + e)/2
    if (s + e + 1e-12 < 1.0) return false;
    if (c > 1.0 + d + 0.5 * (s + e) + 1e-12) return false;

    return true;
}

double steiner_length(double b, double c, double d, double s, double e) {
    // Length |UV| = sqrt( T^2 + T + 1 ), where T = 2d + s + c + e
    const double T = 2.0 * d + s + c + e;
    return std::sqrt(T * T + T + 1.0);
}

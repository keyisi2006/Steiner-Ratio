#include <cmath>
#include <algorithm>

bool X_cond1(double a2, double a3, double a4) {
    const double c = std::sqrt(3.0) / 2.0;
    // Linear trap conditions:
    // a4 ≤ 1 - a3 + (2/√3) a2
    double rhs = 1.0 - a3 + (2.0 / std::sqrt(3.0)) * a2;
    if (a4 > rhs) return false;
    // a3 + a4 ≥ 1
    if (a3 + a4 < 1.0) return false;
    // Foot-on-ray (redundant but kept explicit): 1 + 2*a2 + a3 - a4 ≥ 0
    if (1.0 + 2.0*a2 + a3 - a4 < 0.0) return false;
    return true;
}

double AX_upper_bound1(double a2, double a3, double a4) {
    const double c = std::sqrt(3.0) / 2.0;

    // Distances from A0 to vertices of polygon A0-A1-A2-A3-A4-H-A0
    double d1 = 1.0;
    double d2 = std::sqrt(1.0 + a2 + a2*a2);
    double d3 = std::sqrt(1.0 + a2 + a2*a2 - a3 + a2*a3 + a3*a3);
    double d4 = std::sqrt(
        a2*a2 + a3*a3 +
        a2*(1.0 + a3 - a4) +
        a3*(-1.0 + a4) +
        ( -1.0 + a4 )*( -1.0 + a4 )
    );
    // With cond enforcing a3 + a4 ≥ 1, |A0H| is:
    double dH = c * (a3 + a4 - 1.0);

    return std::max({d1, d2, d3, d4, dH});
}

